{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  name: 'WelcomePage',\n  data() {\n    return {\n      user: {\n        username: '',\n        email: '',\n        is_activated: false\n      }\n    };\n  },\n  async created() {\n    await this.fetchUserData();\n  },\n  methods: {\n    async fetchUserData() {\n      const token = localStorage.getItem('authToken');\n      if (!token) {\n        this.$router.push('/');\n        return;\n      }\n      try {\n        const response = await api.testToken(token);\n        this.user = response.data;\n        if (!this.user.is_activated) {\n          // Можно добавить кнопку для повторной отправки письма активации\n        }\n      } catch (error) {\n        localStorage.removeItem('authToken');\n        this.$router.push('/');\n      }\n    },\n    handleLogout() {\n      localStorage.removeItem('authToken');\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","user","username","email","is_activated","created","fetchUserData","methods","token","localStorage","getItem","$router","push","response","testToken","error","removeItem","handleLogout"],"sources":["/app/src/views/WelcomePage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h1>Добро пожаловать в Shaderedder, {{ user.username }}!</h1>\r\n    <p>Email: {{ user.email }}</p>\r\n    \r\n    <div v-if=\"!user.is_activated\" class=\"activation-warning\">\r\n      Ваш аккаунт еще не активирован. Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации.\r\n    </div>\r\n    \r\n    <button @click=\"handleLogout\">Выйти</button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'WelcomePage',\r\n  data() {\r\n    return {\r\n      user: {\r\n        username: '',\r\n        email: '',\r\n        is_activated: false\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData()\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n      const token = localStorage.getItem('authToken')\r\n      \r\n      if (!token) {\r\n        this.$router.push('/')\r\n        return\r\n      }\r\n      \r\n      try {\r\n        const response = await api.testToken(token)\r\n        this.user = response.data\r\n        \r\n        if (!this.user.is_activated) {\r\n          // Можно добавить кнопку для повторной отправки письма активации\r\n        }\r\n      } catch (error) {\r\n        localStorage.removeItem('authToken')\r\n        this.$router.push('/')\r\n      }\r\n    },\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken')\r\n      this.$router.push('/')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activation-warning {\r\n  margin: 20px 0;\r\n  padding: 15px;\r\n  background-color: #fff3cd;\r\n  color: #856404;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":";AAeA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,YAAY,EAAE;MAChB;IACF;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,aAAa,CAAC;EAC3B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACpB,MAAME,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,WAAW;MAE9C,IAAI,CAACF,KAAK,EAAE;QACV,IAAI,CAACG,OAAO,CAACC,IAAI,CAAC,GAAG;QACrB;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMf,GAAG,CAACgB,SAAS,CAACN,KAAK;QAC1C,IAAI,CAACP,IAAG,GAAIY,QAAQ,CAACb,IAAG;QAExB,IAAI,CAAC,IAAI,CAACC,IAAI,CAACG,YAAY,EAAE;UAC3B;QAAA;MAEJ,EAAE,OAAOW,KAAK,EAAE;QACdN,YAAY,CAACO,UAAU,CAAC,WAAW;QACnC,IAAI,CAACL,OAAO,CAACC,IAAI,CAAC,GAAG;MACvB;IACF,CAAC;IACDK,YAAYA,CAAA,EAAG;MACbR,YAAY,CAACO,UAAU,CAAC,WAAW;MACnC,IAAI,CAACL,OAAO,CAACC,IAAI,CAAC,GAAG;IACvB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}