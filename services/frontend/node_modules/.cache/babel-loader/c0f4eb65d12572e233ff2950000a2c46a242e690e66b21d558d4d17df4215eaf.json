{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  name: 'RegisterPage',\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        const response = await api.register({\n          username: this.username,\n          email: this.email,\n          password: this.password\n        });\n        if (response.data.success) {\n          this.$router.push('/');\n        } else {\n          this.error = response.data.comment || 'Ошибка регистрации';\n        }\n      } catch (error) {\n        this.error = 'Ошибка сервера';\n        console.error(error);\n      }\n    },\n    goToLogin() {\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","username","email","password","error","methods","handleRegister","response","register","success","$router","push","comment","console","goToLogin"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\">Зарегистрироваться</button>\r\n    \r\n    <div class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </div>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      try {\r\n        const response = await api.register({\r\n          username: this.username,\r\n          email: this.email,\r\n          password: this.password\r\n        })\r\n        \r\n        if (response.data.success) {\r\n          this.$router.push('/')\r\n        } else {\r\n          this.error = response.data.comment || 'Ошибка регистрации'\r\n        }\r\n      } catch (error) {\r\n        this.error = 'Ошибка сервера'\r\n        console.error(error)\r\n      }\r\n    },\r\n    goToLogin() {\r\n      this.$router.push('/')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\nform {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 5px;\r\n  box-shadow: 0 0 10px rgba(0,0,0,0.1);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\nlabel {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\ninput {\r\n  width: 100%;\r\n  padding: 10px;\r\n  margin-bottom: 15px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n  box-sizing: border-box;\r\n}\r\n\r\nbutton {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #369f6b;\r\n}\r\n\r\n.error-message {\r\n  color: #ff4444;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.toggle-link {\r\n  margin-top: 15px;\r\n  display: block;\r\n  color: #42b983;\r\n  cursor: pointer;\r\n  text-align: center;\r\n}\r\n\r\n.toggle-link:hover {\r\n  text-decoration: underline;\r\n}\r\n</style>\r\n"],"mappings":";AAkDA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE;IACT;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,GAAG,CAACU,QAAQ,CAAC;UAClCP,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC;QAED,IAAII,QAAQ,CAACP,IAAI,CAACS,OAAO,EAAE;UACzB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,GAAG;QACvB,OAAO;UACL,IAAI,CAACP,KAAI,GAAIG,QAAQ,CAACP,IAAI,CAACY,OAAM,IAAK,oBAAmB;QAC3D;MACF,EAAE,OAAOR,KAAK,EAAE;QACd,IAAI,CAACA,KAAI,GAAI,gBAAe;QAC5BS,OAAO,CAACT,KAAK,CAACA,KAAK;MACrB;IACF,CAAC;IACDU,SAASA,CAAA,EAAG;MACV,IAAI,CAACJ,OAAO,CAACC,IAAI,CAAC,GAAG;IACvB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}