{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  name: 'WelcomePage',\n  data() {\n    return {\n      user: {\n        username: '',\n        email: '',\n        is_activated: false\n      }\n    };\n  },\n  async created() {\n    await this.fetchUserData();\n  },\n  methods: {\n    async fetchUserData() {\n      const token = localStorage.getItem('authToken');\n      if (!token) {\n        this.$router.push('/login');\n        return;\n      }\n      try {\n        const response = await api.get('/login/test-token', {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        this.user = response.data;\n      } catch (error) {\n        localStorage.removeItem('authToken');\n        this.$router.push('/login');\n      }\n    },\n    handleLogout() {\n      localStorage.removeItem('authToken');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","user","username","email","is_activated","created","fetchUserData","methods","token","localStorage","getItem","$router","push","response","get","headers","Authorization","error","removeItem","handleLogout"],"sources":["/app/src/views/WelcomePage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h1>Добро пожаловать, {{ user.username || 'Пользователь' }}!</h1>\r\n    <p v-if=\"user.email\">Email: {{ user.email }}</p>\r\n    \r\n    <div v-if=\"!user.is_activated\" class=\"activation-warning\">\r\n      Ваш аккаунт не активирован. Проверьте почту для подтверждения.\r\n    </div>\r\n    \r\n    <button @click=\"handleLogout\">Выйти</button>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'WelcomePage',\r\n  data() {\r\n    return {\r\n      user: {\r\n        username: '',\r\n        email: '',\r\n        is_activated: false\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData();\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n      const token = localStorage.getItem('authToken');\r\n      if (!token) {\r\n        this.$router.push('/login');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await api.get('/login/test-token', {\r\n          headers: {\r\n            Authorization: `Bearer ${token}`\r\n          }\r\n        });\r\n        this.user = response.data;\r\n      } catch (error) {\r\n        localStorage.removeItem('authToken');\r\n        this.$router.push('/login');\r\n      }\r\n    },\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken');\r\n      this.$router.push('/login');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activation-warning {\r\n  color: #ff9800;\r\n  margin: 20px 0;\r\n  padding: 10px;\r\n  background: #fff3e0;\r\n  border-radius: 4px;\r\n}\r\nbutton {\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background: #ff4444;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n</style>\r\n"],"mappings":";AAcA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,YAAY,EAAE;MAChB;IACF;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,aAAa,CAAC,CAAC;EAC5B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACpB,MAAME,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC;MAC/C,IAAI,CAACF,KAAK,EAAE;QACV,IAAI,CAACG,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;QAC3B;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMf,GAAG,CAACgB,GAAG,CAAC,mBAAmB,EAAE;UAClDC,OAAO,EAAE;YACPC,aAAa,EAAE,UAAUR,KAAK;UAChC;QACF,CAAC,CAAC;QACF,IAAI,CAACP,IAAG,GAAIY,QAAQ,CAACb,IAAI;MAC3B,EAAE,OAAOiB,KAAK,EAAE;QACdR,YAAY,CAACS,UAAU,CAAC,WAAW,CAAC;QACpC,IAAI,CAACP,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;MAC7B;IACF,CAAC;IACDO,YAAYA,CAAA,EAAG;MACbV,YAAY,CAACS,UAAU,CAAC,WAAW,CAAC;MACpC,IAAI,CAACP,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;IAC7B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"modu