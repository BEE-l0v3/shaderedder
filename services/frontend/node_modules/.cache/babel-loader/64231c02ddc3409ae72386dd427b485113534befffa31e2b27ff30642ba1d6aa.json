{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        const response = await api.register({\n          username: this.username,\n          email: this.email,\n          password: this.password\n        });\n        if (response.data.success) {\n          // Переход с передачей email\n          this.$router.push({\n            path: '/confirm-email',\n            query: {\n              email: this.email\n            }\n          });\n        } else {\n          this.error = response.data.comment || 'Ошибка регистрации';\n        }\n      } catch (error) {\n        this.error = 'Ошибка соединения';\n        console.error(error);\n      }\n    },\n    goToLogin() {\n      // Вариант 1: Переход по имени маршрута\n      this.$router.push({\n        name: 'LoginPage'\n      });\n\n      // Или вариант 2: Переход по пути\n      // this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","successMessage","methods","handleRegister","response","register","success","$router","push","path","query","comment","console","goToLogin","name"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <button \r\n    @click.prevent=\"goToLogin\" \r\n    class=\"toggle-link\"\r\n  >\r\n    Есть аккаунт? Войти\r\n  </button>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      successMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n  try {\r\n    const response = await api.register({\r\n      username: this.username,\r\n      email: this.email,\r\n      password: this.password\r\n    });\r\n\r\n    if (response.data.success) {\r\n      // Переход с передачей email\r\n      this.$router.push({\r\n        path: '/confirm-email',\r\n        query: { email: this.email }\r\n      });\r\n    } else {\r\n      this.error = response.data.comment || 'Ошибка регистрации';\r\n    }\r\n  } catch (error) {\r\n    this.error = 'Ошибка соединения';\r\n    console.error(error);\r\n  }\r\n},\r\n\r\ngoToLogin() {\r\n      // Вариант 1: Переход по имени маршрута\r\n      this.$router.push({ name: 'LoginPage' });\r\n      \r\n      // Или вариант 2: Переход по пути\r\n      // this.$router.push('/');\r\n    }\r\n\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.toggle-link {\r\n  background: none;\r\n  border: none;\r\n  color: #42b983;\r\n  cursor: pointer;\r\n  font-size: 1em;\r\n  margin-top: 15px;\r\n  text-decoration: underline;\r\n}\r\n.toggle-link:hover {\r\n  color: #369f6b;\r\n}\r\n</style>"],"mappings":";AA4DA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACzB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,GAAG,CAACU,QAAQ,CAAC;UAClCR,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QAEF,IAAIK,QAAQ,CAACR,IAAI,CAACU,OAAO,EAAE;UACzB;UACA,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC;YAChBC,IAAI,EAAE,gBAAgB;YACtBC,KAAK,EAAE;cAAEZ,KAAK,EAAE,IAAI,CAACA;YAAM;UAC7B,CAAC,CAAC;QACJ,OAAO;UACL,IAAI,CAACE,KAAI,GAAII,QAAQ,CAACR,IAAI,CAACe,OAAM,IAAK,oBAAoB;QAC5D;MACF,EAAE,OAAOX,KAAK,EAAE;QACd,IAAI,CAACA,KAAI,GAAI,mBAAmB;QAChCY,OAAO,CAACZ,KAAK,CAACA,KAAK,CAAC;MACtB;IACF,CAAC;IAEDa,SAASA,CAAA,EAAG;MACN;MACA,IAAI,CAACN,OAAO,CAACC,IAAI,CAAC;QAAEM,IAAI,EAAE;MAAY,CAAC,CAAC;;MAExC;MACA;IACF;EAEF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}