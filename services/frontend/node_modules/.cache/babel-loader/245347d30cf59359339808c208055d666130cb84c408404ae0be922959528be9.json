template>\r\n  <div v-if=\"!loading\">\r\n    <h1>Добро пожаловать, {{ user.username || 'Пользователь' }}!</h1>\r\n    <p v-if=\"user.email\">Email: {{ user.email }}</p>\r\n    <p v-if=\"user.role\">Роль: {{ roleNames[user.role] || user.role }}</p>\r\n    \r\n    <div v-if=\"!user.is_activated\" class=\"activation-warning\">\r\n      Ваш аккаунт не активирован. Проверьте почту для подтверждения.\r\n    </div>\r\n    \r\n    <button @click=\"handleLogout\">Выйти</button>\r\n  </div>\r\n  <div v-else class=\"loading-indicator\">\r\n    Загрузка данных...\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'WelcomePage',\r\n  data() {\r\n    return {\r\n      loading: true,\r\n      user: {\r\n        username: '',\r\n        email: '',\r\n        id: null,\r\n        is_activated: false,\r\n        role: null\r\n      },\r\n      roleNames: {\r\n        1: 'Пользователь',\r\n        2: 'Модератор',\r\n        3: 'Администратор'\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData()\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n      this.loading = true\r\n      const token = localStorage.getItem('authToken')\r\n      \r\n      if (!token) {\r\n        this.$router.push('/login')\r\n        return\r\n      }\r\n\r\n      try {\r\n        const response = await api.testToken(token)\r\n        console.log('Данные пользователя:', response.data)  // Для отладки\r\n        \r\n        this.user = {\r\n          username: response.data.username,\r\n          email: response.data.email,\r\n          id: response.data.id,\r\n          is_activated: response.data.is_activated,\r\n          role: response.data.role\r\n        }\r\n      } catch (error) {\r\n        console.error('Ошибка:', {\r\n          status: error.response?.status,\r\n          data: error.response?.data,\r\n          config: error.config\r\n        })\r\n        this.handleLogout()\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken')\r\n      this.$router.push('/login')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activation-warning {\r\n  color: #ff9800;\r\n  margin: 20px 0;\r\n  padding: 10px;\r\n  background: #fff3e0;\r\n  border-radius: 4px;\r\n}\r\n\r\nbutton {\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background: #ff4444;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.loading-indicator {\r\n  padding: 20px;\r\n  text-align: center;\r\n  color: #666;\r\n}\r\n</style>\r\n"],"mappings":";;EAAAA,GAAA;AAAA;;EAAAA,GAAA;AAAA;;EAAAA,GAAA;AAAA;;EAAAA,GAAA;EAMmCC,KAAK,EAAC;;;EANzCD,GAAA;EAYcC,KAAK,EAAC;;;UAXNC,KAAA,CAAAC,OAAO,I,cAAnBC,mBAAA,CAUM,OAXRC,UAAA,GAEIC,mBAAA,CAAiE,YAA7D,oBAAkB,GAAAC,gBAAA,CAAGL,KAAA,CAAAM,IAAI,CAACC,QAAQ,sBAAqB,GAAC,iBACnDP,KAAA,CAAAM,IAAI,CAACE,KAAK,I,cAAnBN,mBAAA,CAAgD,KAHpDO,UAAA,EAGyB,SAAO,GAAAJ,gBAAA,CAAGL,KAAA,CAAAM,IAAI,CAACE,KAAK,oBAH7CE,mBAAA,gBAIaV,KAAA,CAAAM,IAAI,CAACK,IAAI,I,cAAlBT,mBAAA,CAAqE,KAJzEU,UAAA,EAIwB,QAAM,GAAAP,gBAAA,CAAGL,KAAA,CAAAa,SAAS,CAACb,KAAA,CAAAM,IAAI,CAACK,IAAI,KAAKX,KAAA,CAAAM,IAAI,CAACK,IAAI,oBAJlED,mBAAA,gB,CAMgBV,KAAA,CAAAM,IAAI,CAACQ,YAAY,I,cAA7BZ,mBAAA,CAEM,OAFNa,UAEM,EAFoD,kEAE1D,KARJL,mBAAA,gBAUIN,mBAAA,CAA4C;IAAnCY,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,YAAA,IAAAD,QAAA,CAAAC,YAAA,IAAAF,IAAA,CAAY;KAAE,OAAK,E,oBAErChB,mBAAA,CAEM,OAFNmB,UAEM,EAFgC,sBAEtC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}