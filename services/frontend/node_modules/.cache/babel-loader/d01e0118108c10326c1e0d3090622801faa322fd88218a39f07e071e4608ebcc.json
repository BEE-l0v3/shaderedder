{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  name: 'LoginPage',\n  data() {\n    return {\n      email: '',\n      password: '',\n      error: '',\n      loading: false\n    };\n  },\n  methods: {\n    async handleLogin() {\n      this.loading = true;\n      this.error = '';\n      try {\n        const response = await api.login(this.email, this.password);\n\n        // Сохраняем токен\n        localStorage.setItem('authToken', response.data.access_token);\n\n        // Удаляем неиспользуемую переменную userResponse\n        await api.testToken(response.data.access_token);\n\n        // Перенаправляем на страницу приветствия\n        this.$router.push('/welcome');\n      } catch (error) {\n        if (error.response && error.response.status === 422) {\n          this.error = 'Неверный email или пароль';\n        } else {\n          this.error = 'Произошла ошибка при входе';\n        }\n      } finally {\n        this.loading = false;\n      }\n    },\n    goToRegister() {\n      this.$router.push('/register');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","email","password","error","loading","methods","handleLogin","response","login","localStorage","setItem","access_token","testToken","$router","push","status","goToRegister"],"sources":["/app/src/views/LoginPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleLogin\">\r\n    <h1>ВХОД</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Вход' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToRegister\">\r\n      Нет аккаунта? Зарегистрироваться\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  data() {\r\n    return {\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      loading: false\r\n    }\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.loading = true\r\n      this.error = ''\r\n      \r\n      try {\r\n        const response = await api.login(this.email, this.password)\r\n        \r\n        // Сохраняем токен\r\n        localStorage.setItem('authToken', response.data.access_token)\r\n        \r\n        // Удаляем неиспользуемую переменную userResponse\r\n        await api.testToken(response.data.access_token)\r\n        \r\n        // Перенаправляем на страницу приветствия\r\n        this.$router.push('/welcome')\r\n      } catch (error) {\r\n        if (error.response && error.response.status === 422) {\r\n          this.error = 'Неверный email или пароль'\r\n        } else {\r\n          this.error = 'Произошла ошибка при входе'\r\n        }\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    goToRegister() {\r\n      this.$router.push('/register')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.error-message {\r\n  color: #ff4444;\r\n  margin-bottom: 15px;\r\n}\r\n</style>"],"mappings":";AAyCA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACF,OAAM,GAAI,IAAG;MAClB,IAAI,CAACD,KAAI,GAAI,EAAC;MAEd,IAAI;QACF,MAAMI,QAAO,GAAI,MAAMT,GAAG,CAA