{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        console.log('Пытаемся зарегистрировать:', {\n          username: this.username,\n          email: this.email,\n          password: this.password\n        });\n        const response = await api.register({\n          username: this.username,\n          email: this.email,\n          password: this.password\n        });\n        console.log('Ответ сервера:', response.data);\n        if (response.data.success) {\n          this.$router.push('/registration-success');\n        } else {\n          this.error = response.data.comment || 'Ошибка регистрации';\n        }\n      } catch (error) {\n        console.error('Полная ошибка:', error);\n        if (error.response) {\n          if (error.response.status === 422) {\n            this.error = 'Проверьте данные: ' + (error.response.data.detail?.[0]?.msg || 'неверные данные');\n          } else {\n            this.error = `Ошибка сервера: ${error.response.status}`;\n          }\n        } else {\n          this.error = 'Ошибка соединения. Проверьте:';\n          this.error += '\\n1. Запущен ли бэкенд';\n          this.error += '\\n2. Правильность URL в api/index.js';\n          this.error += '\\n3. CORS-настройки бэкенда';\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","successMessage","methods","handleRegister","console","log","response","register","success","$router","push","comment","status","detail","msg"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      successMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n  try {\r\n    console.log('Пытаемся зарегистрировать:', {\r\n      username: this.username,\r\n      email: this.email,\r\n      password: this.password\r\n    })\r\n\r\n    const response = await api.register({\r\n      username: this.username,\r\n      email: this.email,\r\n      password: this.password\r\n    })\r\n\r\n    console.log('Ответ сервера:', response.data)\r\n    if (response.data.success) {\r\n      this.$router.push('/registration-success')\r\n    } else {\r\n      this.error = response.data.comment || 'Ошибка регистрации'\r\n    }\r\n  } catch (error) {\r\n    console.error('Полная ошибка:', error)\r\n    if (error.response) {\r\n      if (error.response.status === 422) {\r\n        this.error = 'Проверьте данные: ' + \r\n          (error.response.data.detail?.[0]?.msg || 'неверные данные')\r\n      } else {\r\n        this.error = `Ошибка сервера: ${error.response.status}`\r\n      }\r\n    } else {\r\n      this.error = 'Ошибка соединения. Проверьте:'\r\n      this.error += '\\n1. Запущен ли бэкенд'\r\n      this.error += '\\n2. Правильность URL в api/index.js'\r\n      this.error += '\\n3. CORS-настройки бэкенда'\r\n    }\r\n  }\r\n}\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.registration-success {\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #d4edda;\r\n  color: #155724;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":";AAyDA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACzB,IAAI;QACFC,OAAO,CAACC,GAAG,CAAC,4BAA4B,EAAE;UACxCR,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC;QAED,MAAMO,QAAO,GAAI,MAAMX,GAAG,CAACY,QAAQ,CAAC;UAClCV,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC;QAEDK,OAAO,CAACC,GAAG,CAAC,gBAAgB,EAAEC,QAAQ,CAACV,IAAI;QAC3C,IAAIU,QAAQ,CAACV,IAAI,CAACY,OAAO,EAAE;UACzB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,uBAAuB;QAC3C,OAAO;UACL,IAAI,CAACV,KAAI,GAAIM,QAAQ,CAACV,IAAI,CAACe,OAAM,IAAK,oBAAmB;QAC3D;MACF,EAAE,OAAOX,KAAK,EAAE;QACdI,OAAO,CAACJ,KAAK,CAAC,gBAAgB,EAAEA,KAAK;QACrC,IAAIA,KAAK,CAACM,QAAQ,EAAE;UAClB,IAAIN,KAAK,CAACM,QAAQ,CAACM,MAAK,KAAM,GAAG,EAAE;YACjC,IAAI,CAACZ,KAAI,GAAI,oBAAmB,IAC7BA,KAAK,CAACM,QAAQ,CAACV,IA