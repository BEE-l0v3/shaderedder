{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport api from '@/api';\nexport default {\n  name: 'LoginPage',\n  data() {\n    return {\n      email: '',\n      password: '',\n      error: '',\n      loading: false\n    };\n  },\n  methods: {\n    async handleLogin() {\n      try {\n        const formData = new URLSearchParams();\n        formData.append('username', this.email); // Ваш бэкенд ожидает email как username\n        formData.append('password', this.password);\n        formData.append('grant_type', 'password');\n        const response = await api.post('/login/access-token', formData, {\n          headers: {\n            'Content-Type': 'application/x-www-form-urlencoded'\n          }\n        });\n        localStorage.setItem('authToken', response.data.access_token);\n        this.$router.push('/welcome');\n      } catch (error) {\n        if (error.response?.status === 400) {\n          this.error = this.parseLoginError(error.response.data);\n        } else {\n          this.error = 'Ошибка соединения с сервером';\n        }\n      }\n    },\n    parseLoginError(data) {\n      if (data.detail === 'Incorrect email or password') {\n        return 'Неверный email или пароль';\n      }\n      if (data.detail === 'Inactive user') {\n        return 'Аккаунт не активирован. Проверьте почту';\n      }\n      return 'Ошибка входа';\n    },\n    goToRegister() {\n      this.$router.push('/register');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","email","password","error","loading","methods","handleLogin","formData","URLSearchParams","append","response","post","headers","localStorage","setItem","access_token","$router","push","status","parseLoginError","detail","goToRegister"],"sources":["/app/src/views/LoginPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleLogin\">\r\n    <h1>ВХОД</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите password\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Вход' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToRegister\">\r\n      Нет аккаунта? Зарегистрироваться\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  data() {\r\n    return {\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      loading: false\r\n    }\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n  try {\r\n    const formData = new URLSearchParams();\r\n    formData.append('username', this.email); // Ваш бэкенд ожидает email как username\r\n    formData.append('password', this.password);\r\n    formData.append('grant_type', 'password');\r\n\r\n    const response = await api.post('/login/access-token', formData, {\r\n      headers: {\r\n        'Content-Type': 'application/x-www-form-urlencoded'\r\n      }\r\n    });\r\n\r\n    localStorage.setItem('authToken', response.data.access_token);\r\n    this.$router.push('/welcome');\r\n  } catch (error) {\r\n    if (error.response?.status === 400) {\r\n      this.error = this.parseLoginError(error.response.data);\r\n    } else {\r\n      this.error = 'Ошибка соединения с сервером';\r\n    }\r\n  }\r\n},\r\nparseLoginError(data) {\r\n  if (data.detail === 'Incorrect email or password') {\r\n    return 'Неверный email или пароль';\r\n  }\r\n  if (data.detail === 'Inactive user') {\r\n    return 'Аккаунт не активирован. Проверьте почту';\r\n  }\r\n  return 'Ошибка входа';\r\n},\r\n    goToRegister() {\r\n      this.$router.push('/register')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.error-message {\r\n  color: #ff4444;\r\n  margin-bottom: 15px;\r\n}\r\n</style>\r\n"],"mappings":";;;;AAyCA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MACtB,IAAI;QACF,MAAMC,QAAO,GAAI,IAAIC,eAAe,CAAC,CAAC;QACtCD,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACR,KAAK,CAAC,EAAE;QACzCM,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACP,QAAQ,CAAC;QAC1CK,QAAQ,CAACE,MAAM,CAAC,YAAY,EAAE,UAAU,CAAC;QAEzC,MAAMC,QAAO,GAAI,MAAMZ,GAAG,CAACa,IAAI,CAAC,qBAAqB,EAAEJ,QAAQ,EAAE;UAC/DK,OAAO,EAAE;YACP,cAAc,EAAE;UAClB;QACF,CAAC,CAAC;QAEFC,YAAY,CAACC,OAAO,CAAC,WAAW,EAAEJ,QAAQ,CAACV,IAAI,CAACe,YAAY,CAAC;QAC7D,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,UAAU,CAAC;MAC/B,EAAE,OAAOd,KAAK,EAAE;QACd,IAAIA,KAAK,CAACO,QAAQ,EAAEQ,MAAK,KAAM,GAAG,EAAE;UAClC,IAAI,CAACf,KAAI,GAAI,IAAI,CAACgB,eAAe,CAAChB,KAAK,CAACO,QAAQ,CAACV,IAAI,CAAC;QACxD,OAAO;UACL,IAAI,CAACG,KAAI,GAAI,8BAA8B;QAC7C;MACF;IACF,CAAC;IACDgB,eAAeA,CAACnB,IAAI,EAAE;MACpB,IAAIA,IAAI,CAACoB,MAAK,KAAM,6BAA6B,EAAE;QACjD,OAAO,2BAA2B;MACpC;MACA,IAAIpB,IAAI,CAACoB,MAAK,KAAM,eAAe,EAAE;QACnC,OAAO,yCAAyC;MAClD;MACA,OAAO,cAAc;IACvB,CAAC;IACGC,YAAYA,CAAA,EAAG;MACb,IAAI,CAACL,OAAO,CAACC,IAAI,CAAC,WAAW;IAC/B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}