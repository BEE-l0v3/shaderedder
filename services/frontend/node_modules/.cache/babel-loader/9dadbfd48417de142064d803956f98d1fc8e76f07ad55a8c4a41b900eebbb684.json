{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  name: 'WelcomePage',\n  data() {\n    return {\n      loading: true,\n      user: {\n        username: '',\n        is_activated: false\n      }\n    };\n  },\n  async created() {\n    await this.fetchUserData();\n  },\n  methods: {\n    async fetchUserData() {\n      const token = localStorage.getItem('authToken');\n      if (!token) {\n        this.$router.push('/login');\n        return;\n      }\n      try {\n        const response = await api.post('/login/test-token', {}, {\n          // Пустое тело запроса\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        this.user = {\n          username: response.data.username || '',\n          email: response.data.email || '',\n          is_activated: response.data.is_activated || false\n        };\n      } catch (error) {\n        console.error('Ошибка:', error.response?.data || error.message);\n        localStorage.removeItem('authToken');\n        this.$router.push('/login');\n      }\n    },\n    handleLogout() {\n      localStorage.removeItem('authToken');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","loading","user","username","is_activated","created","fetchUserData","methods","token","localStorage","getItem","$router","push","response","post","headers","Authorization","email","error","console","message","removeItem","handleLogout"],"sources":["/app/src/views/WelcomePage.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"!loading\">\r\n    <h1>Добро пожаловать, {{ user.username || 'Пользователь' }}!</h1>\r\n    <p v-if=\"user.email\">Email: {{ user.email }}</p>\r\n    \r\n    <div v-if=\"!user.is_activated\" class=\"activation-warning\">\r\n      Ваш аккаунт не активирован. Проверьте почту для подтверждения.\r\n    </div>\r\n    \r\n    <button @click=\"handleLogout\">Выйти</button>\r\n  </div>\r\n  <div v-else>\r\n    Загрузка...\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'WelcomePage',\r\n  data() {\r\n    return {\r\n      loading: true,\r\n      user: {\r\n        username: '',\r\n        is_activated: false\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData();\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n  const token = localStorage.getItem('authToken');\r\n  if (!token) {\r\n    this.$router.push('/login');\r\n    return;\r\n  }\r\n\r\n  try {\r\n    const response = await api.post('/login/test-token', {}, { // Пустое тело запроса\r\n      headers: { Authorization: `Bearer ${token}` }\r\n    });\r\n    \r\n    this.user = {\r\n      username: response.data.username || '',\r\n      email: response.data.email || '',\r\n      is_activated: response.data.is_activated || false\r\n    };\r\n  } catch (error) {\r\n    console.error('Ошибка:', error.response?.data || error.message);\r\n    localStorage.removeItem('authToken');\r\n    this.$router.push('/login');\r\n  }\r\n},\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken');\r\n      this.$router.push('/login');\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";AAiBA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,IAAI;MACbC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,YAAY,EAAE;MAChB;IACF;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,aAAa,CAAC,CAAC;EAC5B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACxB,MAAME,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC;MAC/C,IAAI,CAACF,KAAK,EAAE;QACV,IAAI,CAACG,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;QAC3B;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMf,GAAG,CAACgB,IAAI,CAAC,mBAAmB,EAAE,CAAC,CAAC,EAAE;UAAE;UACzDC,OAAO,EAAE;YAAEC,aAAa,EAAE,UAAUR,KAAK;UAAG;QAC9C,CAAC,CAAC;QAEF,IAAI,CAACN,IAAG,GAAI;UACVC,QAAQ,EAAEU,QAAQ,CAACb,IAAI,CAACG,QAAO,IAAK,EAAE;UACtCc,KAAK,EAAEJ,QAAQ,CAACb,IAAI,CAACiB,KAAI,IAAK,EAAE;UA