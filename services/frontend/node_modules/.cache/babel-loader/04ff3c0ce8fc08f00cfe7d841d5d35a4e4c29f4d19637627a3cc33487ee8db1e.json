n);\r\n        \r\n        // Проверяем токен и получаем данные пользователя\r\n        await this.$router.push('/welcome');\r\n      } catch (error) {\r\n        if (error.response?.status === 400 || error.response?.status === 401) {\r\n          this.error = 'Неверный логин или пароль';\r\n        } else if (error.response?.status === 422) {\r\n          this.error = 'Ошибка валидации: проверьте введённые данные';\r\n        } else {\r\n          this.error = 'Ошибка соединения с сервером';\r\n        }\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    goToRegister() {\r\n      this.$router.push('/register');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.error-message {\r\n  color: #ff4444;\r\n  margin-bottom: 15px;\r\n}\r\n.toggle-link {\r\n  cursor: pointer;\r\n  color: #42b983;\r\n  text-decoration: underline;\r\n}\r\n</style>\r\n"],"mappings":";;;;AAyCA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MAAG;MACfC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACF,OAAM,GAAI,IAAI;MACnB,IAAI,CAACD,KAAI,GAAI,EAAE;MAEf,IAAI;QACF,MAAMI,QAAO,GAAI,IAAIC,eAAe,CAAC,CAAC;QACtCD,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACR,QAAQ,CAAC,EAAG;QAC7CM,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACP,QAAQ,CAAC;QAC1CK,QAAQ,CAACE,MAAM,CAAC,YAAY,EAAE,UAAU,CAAC;QAEzC,MAAMC,QAAO,GAAI,MAAMZ,GAAG,CAACa,IAAI,CAAC,qBAAqB,EAAEJ,QAAQ,EAAE;UAC/DK,OAAO,EAAE;YACP,cAAc,EAAE;UAClB;QACF,CAAC,CAAC;QAEF,MAAMC,KAAI,GAAIH,QAAQ,CAACV,IAAI,CAACc,YAAY;QACxCC,YAAY,CAACC,OAAO,CAAC,WAAW,EAAEH,KAAK,CAAC;;QAExC;QACA,MAAM,IAAI,CAACI,OAAO,CAACC,IAAI,CAAC,UAAU,CAAC;MACrC,EAAE,OAAOf,KAAK,EAAE;QACd,IAAIA,KAAK,CAACO,QAAQ,EAAES,MAAK,KAAM,GAAE,IAAKhB,KAAK,CAACO,QAAQ,EAAES,MAAK,KAAM,GAAG,EAAE;UACpE,IAAI,CAAChB,KAAI,GAAI,2BAA2B;QAC1C,OAAO,IAAIA,KAAK,CAACO,QAAQ,EAAES,MAAK,KAAM,GAAG,EAAE;UACzC,IAAI,CAAChB,KAAI,GAAI,8CAA8C;QAC7D,OAAO;UACL,IAAI,CAACA,KAAI,