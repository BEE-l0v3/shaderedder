\n      user: {\r\n        username: '',\r\n        email: '',\r\n        is_activated: false\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData();\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n      const token = localStorage.getItem('authToken');\r\n      if (!token) {\r\n        this.$router.push('/login');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await api.get('/login/test-token', {\r\n          headers: {\r\n            Authorization: `Bearer ${token}`\r\n          }\r\n        });\r\n        this.user = response.data;\r\n      } catch (error) {\r\n        localStorage.removeItem('authToken');\r\n        this.$router.push('/login');\r\n      }\r\n    },\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken');\r\n      this.$router.push('/login');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activation-warning {\r\n  color: #ff9800;\r\n  margin: 20px 0;\r\n  padding: 10px;\r\n  background: #fff3e0;\r\n  border-radius: 4px;\r\n}\r\nbutton {\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background: #ff4444;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n</style>\r\n"],"mappings":";;EAAAA,GAAA;AAAA;;EAAAA,GAAA;EAKmCC,KAAK,EAAC;;;uBAJvCC,mBAAA,CASM,cARJC,mBAAA,CAAiE,YAA7D,oBAAkB,GAAAC,gBAAA,CAAGC,KAAA,CAAAC,IAAI,CAACC,QAAQ,sBAAqB,GAAC,iBACnDF,KAAA,CAAAC,IAAI,CAACE,KAAK,I,cAAnBN,mBAAA,CAAgD,KAHpDO,UAAA,EAGyB,SAAO,GAAAL,gBAAA,CAAGC,KAAA,CAAAC,IAAI,CAACE,KAAK,oBAH7CE,mBAAA,gB,CAKgBL,KAAA,CAAAC,IAAI,CAACK,YAAY,I,cAA7BT,mBAAA,CAEM,OAFNU,UAEM,EAFoD,kEAE1D,KAPJF,mBAAA,gBASIP,mBAAA,CAA4C;IAAnCU,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,YAAA,IAAAD,QAAA,CAAAC,YAAA,IAAAF,IAAA,CAAY;KAAE,OAAK,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}