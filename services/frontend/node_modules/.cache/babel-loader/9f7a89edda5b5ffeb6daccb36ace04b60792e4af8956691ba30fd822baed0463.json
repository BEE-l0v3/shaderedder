{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport api from '@/api';\nexport default {\n  name: 'LoginPage',\n  data() {\n    return {\n      username: '',\n      password: '',\n      error: '',\n      loading: false\n    };\n  },\n  methods: {\n    async handleLogin() {\n      this.loading = true;\n      this.error = '';\n      try {\n        const formData = new URLSearchParams();\n        formData.append('username', this.username);\n        formData.append('password', this.password);\n        formData.append('grant_type', 'password');\n\n        // 1. Получаем токен\n        const response = await api.post('/login/access-token', formData, {\n          headers: {\n            'Content-Type': 'application/x-www-form-urlencoded'\n          }\n        });\n\n        // 2. Проверяем наличие токена в ответе\n        if (!response.data?.access_token) {\n          throw new Error('Токен не получен');\n        }\n        const token = response.data.access_token;\n        localStorage.setItem('authToken', token);\n        console.log('Токен сохранён:', token); // Для отладки\n\n        // 3. Перенаправляем с обработкой возможных ошибок\n        await this.$router.push('/welcome').catch(err => {\n          console.error('Ошибка перенаправления:', err);\n          throw err;\n        });\n      } catch (error) {\n        console.error('Ошибка входа:', error);\n        if (error.response?.status === 400 || error.response?.status === 401) {\n          this.error = 'Неверный логин или пароль';\n        } else if (error.message === 'Токен не получен') {\n          this.error = 'Ошибка сервера: токен не получен';\n        } else {\n          this.error = error.message || 'Ошибка соединения с сервером';\n        }\n      } finally {\n        this.loading = false;\n      }\n    },\n    goToRegister() {\n      this.$router.push('/register');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","username","password","error","loading","methods","handleLogin","formData","URLSearchParams","append","response","post","headers","access_token","Error","token","localStorage","setItem","console","log","$router","push","catch","err","status","message","goToRegister"],"sources":["/app/src/views/LoginPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleLogin\">\r\n    <h1>ВХОД</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"Введите nickname\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"Введите password\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Войти' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToRegister\">\r\n      Нет аккаунта? Зарегистрироваться\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'LoginPage',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: '',\r\n      error: '',\r\n      loading: false\r\n    }\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n  this.loading = true;\r\n  this.error = '';\r\n  \r\n  try {\r\n    const formData = new URLSearchParams();\r\n    formData.append('username', this.username);\r\n    formData.append('password', this.password);\r\n    formData.append('grant_type', 'password');\r\n\r\n    // 1. Получаем токен\r\n    const response = await api.post('/login/access-token', formData, {\r\n      headers: {\r\n        'Content-Type': 'application/x-www-form-urlencoded'\r\n      }\r\n    });\r\n\r\n    // 2. Проверяем наличие токена в ответе\r\n    if (!response.data?.access_token) {\r\n      throw new Error('Токен не получен');\r\n    }\r\n\r\n    const token = response.data.access_token;\r\n    localStorage.setItem('authToken', token);\r\n    console.log('Токен сохранён:', token); // Для отладки\r\n\r\n    // 3. Перенаправляем с обработкой возможных ошибок\r\n    await this.$router.push('/welcome').catch(err => {\r\n      console.error('Ошибка перенаправления:', err);\r\n      throw err;\r\n    });\r\n\r\n  } catch (error) {\r\n    console.error('Ошибка входа:', error);\r\n    if (error.response?.status === 400 || error.response?.status === 401) {\r\n      this.error = 'Неверный логин или пароль';\r\n    } else if (error.message === 'Токен не получен') {\r\n      this.error = 'Ошибка сервера: токен не получен';\r\n    } else {\r\n      this.error = error.message || 'Ошибка соединения с сервером';\r\n    }\r\n  } finally {\r\n    this.loading = false;\r\n  }\r\n},\r\n    goToRegister() {\r\n      this.$router.push('/register');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.error-message {\r\n  color: #ff4444;\r\n  margin-bottom: 15px;\r\n}\r\n</style>\r\n"],"mappings":";;;;AAyCA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MACtB,IAAI,CAACF,OAAM,GAAI,IAAI;MACnB,IAAI,CAACD,KAAI,GAAI,EAAE;MAEf,IAAI;QACF,MAAMI,QAAO,GAAI,IAAIC,eAAe,CAAC,CAAC;QACtCD,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACR,QAAQ,CAAC;QAC1CM,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACP,QAAQ,CAAC;QAC1CK,QAAQ,CAACE,MAAM,CAAC,YAAY,EAAE,UAAU,CAAC;;QAEzC;QACA,MAAMC,QAAO,GAAI,MAAMZ,GAAG,CAACa,IAAI,CAAC,qBAAqB,EAAEJ,QAAQ,EAAE