{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  name: 'RegisterPage',\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      loading: false,\n      registrationSuccess: false\n    };\n  },\n  methods: {\n    async handleRegister() {\n      this.loading = true;\n      this.error = '';\n      this.registrationSuccess = false;\n      try {\n        await api.register(this.username, this.email, this.password);\n        this.registrationSuccess = true;\n      } catch (error) {\n        if (error.response && error.response.status === 422) {\n          this.error = 'Проверьте введенные данные: ' + (error.response.data.detail?.[0]?.msg || 'некорректные данные');\n        } else {\n          this.error = 'Произошла ошибка при регистрации: ' + (error.response?.data?.detail || error.message);\n        }\n      } finally {\n        this.loading = false;\n      }\n    },\n    goToLogin() {\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","username","email","password","error","loading","registrationSuccess","methods","handleRegister","register","response","status","detail","msg","message","goToLogin","$router","push"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'RegisterPage',\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      loading: false,\r\n      registrationSuccess: false\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      this.loading = true\r\n      this.error = ''\r\n      this.registrationSuccess = false\r\n      \r\n      try {\r\n        await api.register(this.username, this.email, this.password)\r\n        this.registrationSuccess = true\r\n      } catch (error) {\r\n        if (error.response && error.response.status === 422) {\r\n          this.error = 'Проверьте введенные данные: ' + \r\n            (error.response.data.detail?.[0]?.msg || 'некорректные данные')\r\n        } else {\r\n          this.error = 'Произошла ошибка при регистрации: ' + \r\n            (error.response?.data?.detail || error.message)\r\n        }\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    },\r\n    goToLogin() {\r\n      this.$router.push('/')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.registration-success {\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #d4edda;\r\n  color: #155724;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":";AAyDA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE,KAAK;MACdC,mBAAmB,EAAE;IACvB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI,CAACH,OAAM,GAAI,IAAG;MAClB,IAAI,CAACD,KAAI,GAAI,EAAC;MACd,IAAI,CAACE,mBAAkB,GAAI,KAAI;MAE/B,IAAI;QACF,MAAMR,GAAG,CAACW,QAAQ,CAAC,IAAI,CAACR,QAAQ,EAAE,IAAI,CAACC,KAAK,EAAE,IAAI,CAACC,QAAQ;QAC3D,IAAI,CAACG,mBAAkB,GAAI,IAAG;MAChC,EAAE,OAAOF,KAAK,EAAE;QACd,IAAIA,KAAK,CAACM,QAAO,IAAKN,KAAK,CAACM,QAAQ,CAACC,MAAK,KAAM,GAAG,EAAE;UACnD,IAAI,CAACP,KAAI,GAAI,8BAA6B,IACvCA,KAAK,CAACM,QAAQ,CAACV,IAAI,CAACY,MAAM,GAAG,CAAC,CAAC,EAAEC,GAAE,IAAK,qBAAqB;QAClE,OAAO;UACL,IAAI,CAACT,KAAI,GAAI,oCAAmC,IAC7CA,KAAK,CAACM,QAAQ,EAAEV,IAAI,EAAEY,MAAK,IAAKR,KAAK,CAACU,OAAO;QAClD;MACF,UAAU;QACR,IAAI,CAACT,OAAM,GAAI,KAAI;MACrB;IACF,CAAC;IACDU,SAASA,CAAA,EAAG;MACV,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,GAAG;IACvB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}