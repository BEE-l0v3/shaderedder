{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        const formData = new FormData();\n        formData.append('username', this.username);\n        formData.append('email', this.email);\n        formData.append('password', this.password);\n        const response = await api.post('/register/new', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data' // Или 'application/x-www-form-urlencoded'\n          }\n        });\n        if (response.data.success) {\n          this.$router.push('/confirm-email');\n        }\n      } catch (error) {\n        if (error.response?.data?.detail) {\n          // Ошибки валидации FastAPI\n          this.error = error.response.data.detail.map(err => `${err.loc[1]}: ${err.msg}`).join('\\n');\n        } else {\n          this.error = 'Ошибка регистрации';\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","successMessage","methods","handleRegister","formData","FormData","append","response","post","headers","success","$router","push","detail","map","err","loc","msg","join"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      successMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n  try {\r\n    const formData = new FormData();\r\n    formData.append('username', this.username);\r\n    formData.append('email', this.email);\r\n    formData.append('password', this.password);\r\n\r\n    const response = await api.post('/register/new', formData, {\r\n      headers: {\r\n        'Content-Type': 'multipart/form-data' // Или 'application/x-www-form-urlencoded'\r\n      }\r\n    });\r\n\r\n    if (response.data.success) {\r\n      this.$router.push('/confirm-email');\r\n    }\r\n  } catch (error) {\r\n    if (error.response?.data?.detail) {\r\n      // Ошибки валидации FastAPI\r\n      this.error = error.response.data.detail.map(err => `${err.loc[1]}: ${err.msg}`).join('\\n');\r\n    } else {\r\n      this.error = 'Ошибка регистрации';\r\n    }\r\n  }\r\n}\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.registration-success {\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #d4edda;\r\n  color: #155724;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":";;;AAyDA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACzB,IAAI;QACF,MAAMC,QAAO,GAAI,IAAIC,QAAQ,CAAC,CAAC;QAC/BD,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACT,QAAQ,CAAC;QAC1CO,QAAQ,CAACE,MAAM,CAAC,OAAO,EAAE,IAAI,CAACR,KAAK,CAAC;QACpCM,QAAQ,CAACE,MAAM,CAAC,UAAU,EAAE,IAAI,CAACP,QAAQ,CAAC;QAE1C,MAAMQ,QAAO,GAAI,MAAMZ,GAAG,CAACa,IAAI,CAAC,eAAe,EAAEJ,QAAQ,EAAE;UACzDK,OAAO,EAAE;YACP,cAAc,EAAE,qBAAoB,CAAE;UACxC;QACF,CAAC,CAAC;QAEF,IAAIF,QAAQ,CAACX,IAAI,CAACc,OAAO,EAAE;UACzB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,gBAAgB,CAAC;QACrC;MACF,EAAE,OAAOZ,KAAK,EAAE;QACd,IAAIA,KAAK,CAACO,QAAQ,EAAEX,IAAI,EAAEiB,MAAM,EAAE;UAChC;UACA,IAAI,CAACb,KAAI,GAAIA,KAAK,CAACO,QAAQ,CAACX,IAAI,CAACiB,MAAM,CAACC,GAAG,CAACC,GAAE,IAAK,GAAGA,GAAG,CAACC,GAAG,CAAC,CAAC,CAAC,KAAKD,GAAG,CAACE,GAAG,EAAE,CAAC,CAACC,IAAI,CAAC,IAAI,CAAC;QAC5F,OAAO;UACL,IAAI,CAAClB,KAAI,GAAI,oBAAoB;QACnC;MACF;IACF;EACE;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}