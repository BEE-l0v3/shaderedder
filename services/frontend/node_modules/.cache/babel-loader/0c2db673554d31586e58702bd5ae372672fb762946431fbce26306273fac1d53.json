{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        const response = await api.post('/register/new', {\n          username: String(this.username),\n          email: String(this.email),\n          password: String(this.password)\n        }, {\n          headers: {\n            'Content-Type': 'application/json'\n          }\n        });\n        if (response.data.success) {\n          this.$router.push('/confirm-email');\n        }\n      } catch (error) {\n        if (error.response?.data?.detail) {\n          // Для FastAPI ошибок валидации\n          const errorMsg = error.response.data.detail.map(err => `Ошибка в поле ${err.loc[1]}: ${err.msg}`).join('\\n');\n          this.error = errorMsg;\n        } else {\n          this.error = 'Ошибка сервера';\n        }\n        console.error('Детали ошибки:', error.response?.data);\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","successMessage","methods","handleRegister","response","post","String","headers","success","$router","push","detail","errorMsg","map","err","loc","msg","join","console"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      successMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n  try {\r\n    const response = await api.post('/register/new', {\r\n      username: String(this.username),\r\n      email: String(this.email),\r\n      password: String(this.password)\r\n    }, {\r\n      headers: {\r\n        'Content-Type': 'application/json'\r\n      }\r\n    });\r\n\r\n    if (response.data.success) {\r\n      this.$router.push('/confirm-email');\r\n    }\r\n  } catch (error) {\r\n    if (error.response?.data?.detail) {\r\n      // Для FastAPI ошибок валидации\r\n      const errorMsg = error.response.data.detail.map(err => \r\n        `Ошибка в поле ${err.loc[1]}: ${err.msg}`\r\n      ).join('\\n');\r\n      this.error = errorMsg;\r\n    } else {\r\n      this.error = 'Ошибка сервера';\r\n    }\r\n    console.error('Детали ошибки:', error.response?.data);\r\n  }\r\n}\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.registration-success {\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #d4edda;\r\n  color: #155724;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":";;;AAyDA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACzB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,GAAG,CAACU,IAAI,CAAC,eAAe,EAAE;UAC/CR,QAAQ,EAAES,MAAM,CAAC,IAAI,CAACT,QAAQ,CAAC;UAC/BC,KAAK,EAAEQ,MAAM,CAAC,IAAI,CAACR,KAAK,CAAC;UACzBC,QAAQ,EAAEO,MAAM,CAAC,IAAI,CAACP,QAAQ;QAChC,CAAC,EAAE;UACDQ,OAAO,EAAE;YACP,cAAc,EAAE;UAClB;QACF,CAAC,CAAC;QAEF,IAAIH,QAAQ,CAACR,IAAI,CAACY,OAAO,EAAE;UACzB,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,gBAAgB,CAAC;QACrC;MACF,EAAE,OAAOV,KAAK,EAAE;QACd,IAAIA,KAAK,CAACI,QAAQ,EAAER,IAAI,EAAEe,MAAM,EAAE;UAChC;UACA,MAAMC,QAAO,GAAIZ,KAAK,CAACI,QAAQ,CAACR,IAAI,CAACe,MAAM,CAACE,GAAG,CAACC,GAAE,IAChD,iBAAiBA,GAAG,CAACC,GAAG,CAAC,CAAC,CAAC,KAAKD,GAAG,CAACE,GAAG,EACzC,CAAC,CAACC,IAAI,CAAC,IAAI,CAAC;UACZ,IAAI,CAACjB,KAAI,GAAIY,QAAQ;QACvB,OAAO;UACL,IAAI,CAACZ,KAAI,GAAI,gBAAgB;QAC/B;QACAkB,OAAO,CAAClB,KAAK,CAAC,gBAAgB,EAAEA,KAAK,CAACI,QAAQ,EAAER,IAAI,CAAC;MACvD;IACF;EACE;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}