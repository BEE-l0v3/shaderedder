{"ast":null,"code":"import api from '@/api';\nexport default {\n  name: 'ConfirmRegistrationPage',\n  data() {\n    return {\n      loading: true,\n      success: false,\n      error: ''\n    };\n  },\n  async created() {\n    const token = this.$route.query.token;\n    if (!token) {\n      this.error = 'Токен подтверждения отсутствует';\n      this.loading = false;\n      return;\n    }\n    try {\n      await api.confirmRegistration(token);\n      this.success = true;\n    } catch (error) {\n      if (error.response && error.response.status === 422) {\n        this.error = 'Неверный или устаревший токен подтверждения';\n      } else {\n        this.error = 'Произошла ошибка при подтверждении регистрации';\n      }\n    } finally {\n      this.loading = false;\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","loading","success","error","created","token","$route","query","confirmRegistration","response","status"],"sources":["/app/src/views/ConfirmRegistrationPage.vue"],"sourcesContent":["<template>\r\n    <div class=\"confirmation-container\">\r\n      <h1>Подтверждение регистрации</h1>\r\n      \r\n      <div v-if=\"loading\" class=\"loading-message\">\r\n        Идет подтверждение аккаунта...\r\n      </div>\r\n      \r\n      <div v-if=\"success\" class=\"success-message\">\r\n        Ваш аккаунт успешно активирован! Теперь вы можете войти.\r\n        <router-link to=\"/\">Перейти на страницу входа</router-link>\r\n      </div>\r\n      \r\n      <div v-if=\"error\" class=\"error-message\">\r\n        {{ error }}\r\n        <router-link to=\"/\">Перейти на страницу входа</router-link>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import api from '@/api'\r\n  \r\n  export default {\r\n    name: 'ConfirmRegistrationPage',\r\n    data() {\r\n      return {\r\n        loading: true,\r\n        success: false,\r\n        error: ''\r\n      }\r\n    },\r\n    async created() {\r\n      const token = this.$route.query.token\r\n      \r\n      if (!token) {\r\n        this.error = 'Токен подтверждения отсутствует'\r\n        this.loading = false\r\n        return\r\n      }\r\n      \r\n      try {\r\n        await api.confirmRegistration(token)\r\n        this.success = true\r\n      } catch (error) {\r\n        if (error.response && error.response.status === 422) {\r\n          this.error = 'Неверный или устаревший токен подтверждения'\r\n        } else {\r\n          this.error = 'Произошла ошибка при подтверждении регистрации'\r\n        }\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .confirmation-container {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n    text-align: center;\r\n  }\r\n  \r\n  .loading-message, .success-message, .error-message {\r\n    margin: 20px 0;\r\n    padding: 15px;\r\n    border-radius: 5px;\r\n  }\r\n  \r\n  .loading-message {\r\n    background-color: #f8f9fa;\r\n    color: #6c757d;\r\n  }\r\n  \r\n  .success-message {\r\n    background-color: #d4edda;\r\n    color: #155724;\r\n  }\r\n  \r\n  .error-message {\r\n    background-color: #f8d7da;\r\n    color: #721c24;\r\n  }\r\n  \r\n  a {\r\n    display: block;\r\n    margin-top: 10px;\r\n    color: #007bff;\r\n    text-decoration: none;\r\n  }\r\n  \r\n  a:hover {\r\n    text-decoration: underline;\r\n  }\r\n  </style>"],"mappings":"AAqBE,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,IAAI;MACbC,OAAO,EAAE,KAAK;MACdC,KAAK,EAAE;IACT;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAMC,KAAI,GAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,KAAI;IAEpC,IAAI,CAACA,KAAK,EAAE;MACV,IAAI,CAACF,KAAI,GAAI,iCAAgC;MAC7C,IAAI,CAACF,OAAM,GAAI,KAAI;MACnB;IACF;IAEA,IAAI;MACF,MAAMH,GAAG,CAACU,mBAAmB,CAACH,KAAK;MACnC,IAAI,CAACH,OAAM,GAAI,IAAG;IACpB,EAAE,OAAOC,KAAK,EAAE;MACd,IAAIA,KAAK,CAACM,QAAO,IAAKN,KAAK,CAACM,QAAQ,CAACC,MAAK,KAAM,GAAG,EAAE;QACnD,IAAI,CAACP,KAAI,GAAI,6CAA4C;MAC3D,OA