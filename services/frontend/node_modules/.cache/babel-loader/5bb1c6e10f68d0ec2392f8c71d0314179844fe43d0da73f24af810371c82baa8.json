      is_activated: false\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData()\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n      const token = localStorage.getItem('authToken')\r\n      \r\n      if (!token) {\r\n        this.$router.push('/')\r\n        return\r\n      }\r\n      \r\n      try {\r\n        const response = await api.testToken(token)\r\n        this.user = response.data\r\n        \r\n        if (!this.user.is_activated) {\r\n          // Можно добавить кнопку для повторной отправки письма активации\r\n        }\r\n      } catch (error) {\r\n        localStorage.removeItem('authToken')\r\n        this.$router.push('/')\r\n      }\r\n    },\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken')\r\n      this.$router.push('/')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activation-warning {\r\n  margin: 20px 0;\r\n  padding: 15px;\r\n  background-color: #fff3cd;\r\n  color: #856404;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":";;EAAAA,GAAA;EAKmCC,KAAK,EAAC;;;uBAJvCC,mBAAA,CAUM,cATJC,mBAAA,CAA6D,YAAzD,kCAAgC,GAAAC,gBAAA,CAAGC,KAAA,CAAAC,IAAI,CAACC,QAAQ,IAAG,GAAC,iBACxDJ,mBAAA,CAA8B,WAA3B,SAAO,GAAAC,gBAAA,CAAGC,KAAA,CAAAC,IAAI,CAACE,KAAK,kB,CAEXH,KAAA,CAAAC,IAAI,CAACG,YAAY,I,cAA7BP,mBAAA,CAGM,OAHNQ,UAGM,EAHoD,yGAG1D,KARJC,mBAAA,gBAUIR,mBAAA,CAA4C;IAAnCS,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,YAAA,IAAAD,QAAA,CAAAC,YAAA,IAAAF,IAAA,CAAY;KAAE,OAAK,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}