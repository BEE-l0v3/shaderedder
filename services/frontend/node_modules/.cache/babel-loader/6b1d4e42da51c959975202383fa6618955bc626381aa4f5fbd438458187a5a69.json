{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        // 1. Подготовка данных с валидацией\n        const regData = {\n          username: String(this.username).trim(),\n          email: String(this.email).trim().toLowerCase(),\n          password: String(this.password)\n        };\n        console.log('Отправка данных:', regData);\n\n        // 2. Отправка запроса с обработкой ошибок\n        const response = await api.post('/register/new', regData, {\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          timeout: 8000\n        });\n\n        // 3. Обработка ответа\n        if (response.data?.success) {\n          this.$router.push('/confirm-email');\n        } else {\n          throw new Error(response.data?.comment || 'Неизвестная ошибка сервера');\n        }\n      } catch (error) {\n        console.error('Полная ошибка:', error);\n\n        // 4. Детализированное отображение ошибок\n        if (error.response) {\n          // Ошибки FastAPI\n          const apiError = error.response.data?.detail || error.response.data;\n          this.error = Array.isArray(apiError) ? apiError.map(e => `${e.loc?.[1] || 'Поле'}: ${e.msg}`).join('\\n') : apiError.message || JSON.stringify(apiError);\n        } else if (error.request) {\n          // Проблемы сети\n          this.error = `Сервер не ответил. Проверьте:\\n1. Запущен ли бэкенд\\n2. CORS настройки\\n3. Сетевые подключения`;\n        } else {\n          // Ошибки кода\n          this.error = `Ошибка при отправке: ${error.message}`;\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","successMessage","methods","handleRegister","regData","String","trim","toLowerCase","console","log","response","post","headers","timeout","success","$router","push","Error","comment","apiError","detail","Array","isArray","map","e","loc","msg","join","message","JSON","stringify","request"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      successMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n  try {\r\n    // 1. Подготовка данных с валидацией\r\n    const regData = {\r\n      username: String(this.username).trim(),\r\n      email: String(this.email).trim().toLowerCase(),\r\n      password: String(this.password)\r\n    };\r\n\r\n    console.log('Отправка данных:', regData);\r\n\r\n    // 2. Отправка запроса с обработкой ошибок\r\n    const response = await api.post('/register/new', regData, {\r\n      headers: {\r\n        'Content-Type': 'application/json'\r\n      },\r\n      timeout: 8000\r\n    });\r\n\r\n    // 3. Обработка ответа\r\n    if (response.data?.success) {\r\n      this.$router.push('/confirm-email');\r\n    } else {\r\n      throw new Error(response.data?.comment || 'Неизвестная ошибка сервера');\r\n    }\r\n  } catch (error) {\r\n    console.error('Полная ошибка:', error);\r\n    \r\n    // 4. Детализированное отображение ошибок\r\n    if (error.response) {\r\n      // Ошибки FastAPI\r\n      const apiError = error.response.data?.detail || error.response.data;\r\n      this.error = Array.isArray(apiError) \r\n        ? apiError.map(e => `${e.loc?.[1] || 'Поле'}: ${e.msg}`).join('\\n')\r\n        : apiError.message || JSON.stringify(apiError);\r\n    } else if (error.request) {\r\n      // Проблемы сети\r\n      this.error = `Сервер не ответил. Проверьте:\\n1. Запущен ли бэкенд\\n2. CORS настройки\\n3. Сетевые подключения`;\r\n    } else {\r\n      // Ошибки кода\r\n      this.error = `Ошибка при отправке: ${error.message}`;\r\n    }\r\n  }\r\n}\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.registration-success {\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #d4edda;\r\n  color: #155724;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":";;;AAyDA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,E