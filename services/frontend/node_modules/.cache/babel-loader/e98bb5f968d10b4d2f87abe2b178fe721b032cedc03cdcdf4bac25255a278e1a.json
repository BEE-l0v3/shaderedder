{"ast":null,"code":"import api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        const response = await api.register({\n          username: this.username,\n          email: this.email,\n          password: this.password\n        });\n        if (response.data.success) {\n          this.successMessage = 'Письмо с подтверждением отправлено! Проверьте вашу почту.';\n          this.error = '';\n        } else {\n          this.error = response.data.comment || 'Ошибка регистрации';\n        }\n      } catch (error) {\n        this.error = 'Ошибка соединения с сервером';\n        console.error('Registration error:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","successMessage","methods","handleRegister","response","register","success","comment","console"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <span class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </span>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      successMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      try {\r\n        const response = await api.register({\r\n          username: this.username,\r\n          email: this.email,\r\n          password: this.password\r\n        })\r\n        \r\n        if (response.data.success) {\r\n          this.successMessage = 'Письмо с подтверждением отправлено! Проверьте вашу почту.'\r\n          this.error = ''\r\n        } else {\r\n          this.error = response.data.comment || 'Ошибка регистрации'\r\n        }\r\n      } catch (error) {\r\n        this.error = 'Ошибка соединения с сервером'\r\n        console.error('Registration error:', error)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.registration-success {\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #d4edda;\r\n  color: #155724;\r\n  border-radius: 5px;\r\n}\r\n</style>"],"mappings":"AAyDA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,GAAG,CAACU,QAAQ,C