{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  name: 'WelcomePage',\n  data() {\n    return {\n      loading: true,\n      user: {\n        username: '',\n        email: '',\n        id: null,\n        is_activated: false,\n        role: null\n      },\n      roleNames: {\n        1: 'Пользователь',\n        2: 'Модератор',\n        3: 'Администратор'\n      }\n    };\n  },\n  async created() {\n    await this.fetchUserData();\n  },\n  methods: {\n    async fetchUserData() {\n      this.loading = true;\n      const token = localStorage.getItem('authToken');\n      console.log('Используемый токен:', token); // Логируем токен\n\n      try {\n        const response = await api.testToken(token);\n        console.log('Ответ сервера:', response.data); // Логируем ответ\n\n        this.user = response.data;\n      } catch (error) {\n        console.error('Полная ошибка:', {\n          status: error.response?.status,\n          data: error.response?.data,\n          config: error.config // Параметры запроса\n        });\n        this.handleLogout();\n      } finally {\n        this.loading = false;\n      }\n    },\n    handleLogout() {\n      localStorage.removeItem('authToken');\n      localStorage.removeItem('userData');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["api","name","data","loading","user","username","email","id","is_activated","role","roleNames","created","fetchUserData","methods","token","localStorage","getItem","console","log","response","testToken","error","status","config","handleLogout","removeItem","$router","push"],"sources":["/app/src/views/WelcomePage.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"!loading\">\r\n    <h1>Добро пожаловать, {{ user.username || 'Пользователь' }}!</h1>\r\n    <p v-if=\"user.email\">Email: {{ user.email }}</p>\r\n    <p v-if=\"user.role\">Роль: {{ roleNames[user.role] || user.role }}</p>\r\n    \r\n    <div v-if=\"!user.is_activated\" class=\"activation-warning\">\r\n      Ваш аккаунт не активирован. Проверьте почту для подтверждения.\r\n    </div>\r\n    \r\n    <button @click=\"handleLogout\">Выйти</button>\r\n  </div>\r\n  <div v-else class=\"loading-indicator\">\r\n    Загрузка данных...\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'WelcomePage',\r\n  data() {\r\n    return {\r\n      loading: true,\r\n      user: {\r\n        username: '',\r\n        email: '',\r\n        id: null,\r\n        is_activated: false,\r\n        role: null\r\n      },\r\n      roleNames: {\r\n        1: 'Пользователь',\r\n        2: 'Модератор',\r\n        3: 'Администратор'\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData()\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n  this.loading = true;\r\n  const token = localStorage.getItem('authToken');\r\n  \r\n  console.log('Используемый токен:', token); // Логируем токен\r\n  \r\n  try {\r\n    const response = await api.testToken(token);\r\n    console.log('Ответ сервера:', response.data); // Логируем ответ\r\n    \r\n    this.user = response.data;\r\n  } catch (error) {\r\n    console.error('Полная ошибка:', {\r\n      status: error.response?.status,\r\n      data: error.response?.data,\r\n      config: error.config // Параметры запроса\r\n    });\r\n    this.handleLogout();\r\n  } finally {\r\n    this.loading = false;\r\n  }\r\n},\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken')\r\n      localStorage.removeItem('userData')\r\n      this.$router.push('/login')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.activation-warning {\r\n  color: #ff9800;\r\n  margin: 20px 0;\r\n  padding: 10px;\r\n  background: #fff3e0;\r\n  border-radius: 4px;\r\n}\r\n\r\nbutton {\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background: #ff4444;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.loading-indicator {\r\n  padding: 20px;\r\n  text-align: center;\r\n  color: #666;\r\n}\r\n</style>\r\n"],"mappings":";AAkBA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,IAAI;MACbC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,EAAE,EAAE,IAAI;QACRC,YAAY,EAAE,KAAK;QACnBC,IAAI,EAAE;MACR,CAAC;MACDC,SAAS,EAAE;QACT,CAAC,EAAE,cAAc;QACjB,CAAC,EAAE,WAAW;QACd,CAAC,EAAE;MACL;IACF;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,aAAa,CAAC;EAC3B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACxB,IAAI,CAACT,OAAM,GAAI,IAAI;MACnB,MAAMW,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC;MAE/CC,OAAO,CAACC,GAAG,CAAC,qBAAqB,EAAEJ,KAAK,CAAC,EAAE;;MAE3C,IAAI;QACF,MAAMK,QAAO,GAAI,MAAMnB,GAAG,CAACoB,SAAS,CAACN,KAAK,CAAC;QAC3CG,OAAO,CAACC,GAAG,CAAC,gBAAgB,EAAEC,QAAQ,CAACjB,IAAI,CAAC,EAAE;;QAE9C,IAAI,CAACE,IAAG,GAAIe,QAAQ,CAACjB,IAAI;MAC3B,EAAE,OAAOmB,KAAK,EAAE;QACdJ,OAAO,CAACI,KAAK,CAAC,gBAAgB,EAAE;UAC9BC,MAAM,EAAED,KAAK,CAACF,QAAQ,EAAEG,MAAM;UAC9BpB,IAAI,EAAEmB,KAAK,CAACF,QAAQ,EAAEjB,IAAI;UAC1BqB,MAAM,EAAEF,KAAK,CAACE,MAAK,CAAE;QACvB,CAAC,CAAC;QACF,IAAI,CAACC,YAAY,CAAC,CAAC;MACrB,UAAU;QACR,IAAI,CAACrB,OAAM,GAAI,KAAK;MACtB;IACF,CAAC;IACGqB,YAAYA,CAAA,EAAG;MACbT,YAAY,CAACU,UAAU,CAAC,WAAW;MACnCV,YAAY,CAACU,UAAU,CAAC,UAAU;MAClC,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ;IAC5B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}