{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        this.error = \"\";\n        const response = await api.post('/register/new', {\n          username: this.username,\n          email: this.email,\n          password: this.password\n        });\n        if (response.data.success) {\n          this.$router.push({\n            path: '/confirm-email',\n            query: {\n              email: this.email,\n              manual_check: true // Добавляем флаг ручной проверки\n            }\n          });\n        } else {\n          this.error = response.data.comment || 'Ошибка регистрации';\n        }\n      } catch (error) {\n        this.error = this.parseError(error);\n      }\n    },\n    parseError(error) {\n      if (error.response?.data?.detail) {\n        return error.response.data.detail.map(e => e.msg).join(', ');\n      }\n      return error.message || 'Ошибка соединения с сервером';\n    },\n    goToLogin() {\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","methods","handleRegister","response","post","success","$router","push","path","query","manual_check","comment","parseError","detail","map","e","msg","join","message","goToLogin"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\">Зарегистрироваться</button>\r\n    \r\n    <div class=\"toggle-link\" @click=\"goToLogin\">\r\n      Есть аккаунта? Войти\r\n    </div>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n  try {\r\n    this.error = \"\";\r\n    const response = await api.post('/register/new', {\r\n      username: this.username,\r\n      email: this.email,\r\n      password: this.password\r\n    });\r\n\r\n    if (response.data.success) {\r\n      this.$router.push({\r\n        path: '/confirm-email',\r\n        query: { \r\n          email: this.email,\r\n          manual_check: true // Добавляем флаг ручной проверки\r\n        }\r\n      });\r\n    } else {\r\n      this.error = response.data.comment || 'Ошибка регистрации';\r\n    }\r\n  } catch (error) {\r\n    this.error = this.parseError(error);\r\n  }\r\n},\r\nparseError(error) {\r\n  if (error.response?.data?.detail) {\r\n    return error.response.data.detail.map(e => e.msg).join(', ');\r\n  }\r\n  return error.message || 'Ошибка соединения с сервером';\r\n},\r\n    goToLogin() {\r\n      this.$router.push('/');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\nform {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n.error-message {\r\n  color: red;\r\n}\r