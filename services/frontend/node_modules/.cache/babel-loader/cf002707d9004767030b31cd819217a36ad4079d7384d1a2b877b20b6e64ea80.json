.\r\n    </div>\r\n    \r\n    <button @click=\"handleLogout\">Выйти</button>\r\n  </div>\r\n  <div v-else>\r\n    Загрузка...\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  name: 'WelcomePage',\r\n  data() {\r\n    return {\r\n      loading: true,\r\n      user: {\r\n        username: '',\r\n        is_activated: false\r\n      }\r\n    }\r\n  },\r\n  async created() {\r\n    await this.fetchUserData();\r\n  },\r\n  methods: {\r\n    async fetchUserData() {\r\n      this.loading = true;\r\n      const token = localStorage.getItem('authToken');\r\n      \r\n      if (!token) {\r\n        this.$router.push('/login');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await api.get('/login/test-token', {\r\n          headers: { Authorization: `Bearer ${token}` }\r\n        });\r\n        \r\n        // Проверка структуры ответа\r\n        if (response.data) {\r\n          this.user = {\r\n            username: response.data.username || response.data.login || '',\r\n            is_activated: Boolean(response.data.is_activated)\r\n          };\r\n        }\r\n      } catch (error) {\r\n        console.error('Ошибка получения данных:', error.response?.data || error.message);\r\n        localStorage.removeItem('authToken');\r\n        this.$router.push('/login');\r\n      } finally {\r\n        this.loading = false;\r\n      }\r\n    },\r\n    handleLogout() {\r\n      localStorage.removeItem('authToken');\r\n      this.$router.push('/login');\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;EAAAA,GAAA;AAAA;;EAAAA,GAAA;AAAA;;EAAAA,GAAA;EAKmCC,KAAK,EAAC;;;EALzCD,GAAA;AAAA;;UACcE,KAAA,CAAAC,OAAO,I,cAAnBC,mBAAA,CASM,OAVRC,UAAA,GAEIC,mBAAA,CAAiE,YAA7D,oBAAkB,GAAAC,gBAAA,CAAGL,KAAA,CAAAM,IAAI,CAACC,QAAQ,sBAAqB,GAAC,iBACnDP,KAAA,CAAAM,IAAI,CAACE,KAAK,I,cAAnBN,mBAAA,CAAgD,KAHpDO,UAAA,EAGyB,SAAO,GAAAJ,gBAAA,CAAGL,KAAA,CAAAM,IAAI,CAACE,KAAK,oBAH7CE,mBAAA,gB,CAKgBV,KAAA,CAAAM,IAAI,CAACK,YAAY,I,cAA7BT