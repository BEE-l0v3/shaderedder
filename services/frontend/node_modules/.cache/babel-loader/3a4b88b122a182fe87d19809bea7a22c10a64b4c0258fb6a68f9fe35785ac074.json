{"ast":null,"code":"import api from '@/api';\nexport default {\n  async mounted() {\n    const token = this.$route.query.token;\n    if (!token) {\n      this.error = 'Отсутствует токен подтверждения';\n      return;\n    }\n    try {\n      const response = await api.confirmRegistration({\n        access_token: token\n      });\n      if (response.data.success) {\n        this.success = true;\n      } else {\n        this.error = response.data.comment || 'Ошибка активации';\n      }\n    } catch (error) {\n      this.error = 'Ошибка сервера при активации';\n    }\n  }\n};","map":{"version":3,"names":["api","mounted","token","$route","query","error","response","confirmRegistration","access_token","data","success","comment"],"sources":["/app/src/views/ConfirmRegistrationPage.vue"],"sourcesContent":["<template>\r\n    <div class=\"confirmation-container\">\r\n      <h1>Подтверждение регистрации</h1>\r\n      \r\n      <div v-if=\"loading\" class=\"loading-message\">\r\n        Идет подтверждение аккаунта...\r\n      </div>\r\n      \r\n      <div v-if=\"success\" class=\"success-message\">\r\n        Ваш аккаунт успешно активирован! Теперь вы можете войти.\r\n        <router-link to=\"/\">Перейти на страницу входа</router-link>\r\n      </div>\r\n      \r\n      <div v-if=\"error\" class=\"error-message\">\r\n        {{ error }}\r\n        <router-link to=\"/\">Перейти на страницу входа</router-link>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  async mounted() {\r\n    const token = this.$route.query.token\r\n    if (!token) {\r\n      this.error = 'Отсутствует токен подтверждения'\r\n      return\r\n    }\r\n\r\n    try {\r\n      const response = await api.confirmRegistration({ access_token: token })\r\n      if (response.data.success) {\r\n        this.success = true\r\n      } else {\r\n        this.error = response.data.comment || 'Ошибка активации'\r\n      }\r\n    } catch (error) {\r\n      this.error = 'Ошибка сервера при активации'\r\n    }\r\n  }\r\n}\r\n</script>\r\n  \r\n  <style scoped>\r\n  .confirmation-container {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n    text-align: center;\r\n  }\r\n  \r\n  .loading-message, .success-message, .error-message {\r\n    margin: 20px 0;\r\n    padding: 15px;\r\n    border-radius: 5px;\r\n  }\r\n  \r\n  .loading-message {\r\n    background-color: #f8f9fa;\r\n    color: #6c757d;\r\n  }\r\n  \r\n  .success-message {\r\n    background-color: #d4edda;\r\n    color: #155724;\r\n  }\r\n  \r\n  .error-message {\r\n    background-color: #f8d7da;\r\n    color: #721c24;\r\n  }\r\n  \r\n  a {\r\n    display: block;\r\n    margin-top: 10px;\r\n    color: #007bff;\r\n    text-decoration: none;\r\n  }\r\n  \r\n  a:hover {\r\n    text-decoration: underline;\r\n  }\r\n  </style>"],"mappings":"AAqBA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACb,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAMC,KAAI,GAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,KAAI;IACpC,IAAI,CAACA,KAAK,EAAE;MACV,IAAI,CAACG,KAAI,GAAI,iCAAgC;MAC7C;IACF;IAEA,IAAI;MACF,MAAMC,QAAO,GAAI,MAAMN,GAAG,CAACO,mBAAmB,CAAC;QAAEC,YAAY,EAAEN;MAAM,CAAC;MACtE,IAAII,QAAQ,CAACG,IAAI,CAACC,OAAO,EAAE;QACzB,IAAI,CAACA,OAAM,GAAI,IAAG;MACpB,OAAO;QACL,IAAI,CAACL,KAAI,GAAIC,QAAQ,CAACG,IAAI,CAACE,OAAM,IAAK,kBAAiB;MACzD;IACF,EAAE,OAAON,KAAK,EAAE;MACd,IAAI,CAACA,KAAI,GAAI,8BAA6B;IAC5C;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}