{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport api from '@/api';\nexport default {\n  data() {\n    return {\n      username: '',\n      email: '',\n      password: '',\n      error: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async handleRegister() {\n      try {\n        // Проверка данных перед отправкой\n        if (!this.email.includes('@')) {\n          throw new Error('Email должен содержать @');\n        }\n        if (this.password.length < 6) {\n          throw new Error('Пароль должен быть не менее 6 символов');\n        }\n\n        // Отправка данных\n        const response = await api.post('/register/new', {\n          username: this.username,\n          email: this.email,\n          password: this.password\n        });\n\n        // Обработка ответа\n        if (response.data?.success) {\n          this.$router.push('/confirm-email');\n        } else {\n          throw new Error(response.data?.comment || 'Ошибка регистрации');\n        }\n      } catch (error) {\n        console.error('Ошибка регистрации:', error);\n        this.error = error.message;\n      }\n    },\n    goToLogin() {\n      // Вариант 1: Переход по имени маршрута\n      this.$router.push({\n        name: 'LoginPage'\n      });\n\n      // Или вариант 2: Переход по пути\n      // this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["api","data","username","email","password","error","successMessage","methods","handleRegister","includes","Error","length","response","post","success","$router","push","comment","console","message","goToLogin","name"],"sources":["/app/src/views/RegisterPage.vue"],"sourcesContent":["<template>\r\n  <form @submit.prevent=\"handleRegister\">\r\n    <h1>РЕГИСТРАЦИЯ</h1>\r\n    \r\n    <div v-if=\"error\" class=\"error-message\">\r\n      {{ error }}\r\n    </div>\r\n    \r\n    <div v-if=\"registrationSuccess\" class=\"registration-success\">\r\n      Регистрация прошла успешно! Пожалуйста, проверьте вашу почту \r\n      и перейдите по ссылке для активации аккаунта.\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"username\">Имя пользователя</label>\r\n      <input \r\n        id=\"username\" \r\n        type=\"text\" \r\n        v-model=\"username\" \r\n        placeholder=\"введите имя пользователя\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"email\">Email</label>\r\n      <input \r\n        id=\"email\" \r\n        type=\"email\" \r\n        v-model=\"email\" \r\n        placeholder=\"введите email\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <div>\r\n      <label for=\"password\">Пароль</label>\r\n      <input \r\n        id=\"password\" \r\n        type=\"password\" \r\n        v-model=\"password\" \r\n        placeholder=\"введите пароль\" \r\n        required\r\n      >\r\n    </div>\r\n    \r\n    <button type=\"submit\" :disabled=\"loading\">\r\n      {{ loading ? 'Загрузка...' : 'Зарегистрироваться' }}\r\n    </button>\r\n    \r\n    <button \r\n    @click.prevent=\"goToLogin\" \r\n    class=\"toggle-link\"\r\n  >\r\n    Есть аккаунт? Войти\r\n  </button>\r\n  </form>\r\n</template>\r\n\r\n<script>\r\nimport api from '@/api'\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n      error: '',\r\n      successMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n  try {\r\n    // Проверка данных перед отправкой\r\n    if (!this.email.includes('@')) {\r\n      throw new Error('Email должен содержать @')\r\n    }\r\n    if (this.password.length < 6) {\r\n      throw new Error('Пароль должен быть не менее 6 символов')\r\n    }\r\n\r\n    // Отправка данных\r\n    const response = await api.post('/register/new', {\r\n      username: this.username,\r\n      email: this.email,\r\n      password: this.password\r\n    })\r\n\r\n    // Обработка ответа\r\n    if (response.data?.success) {\r\n      this.$router.push('/confirm-email')\r\n    } else {\r\n      throw new Error(response.data?.comment || 'Ошибка регистрации')\r\n    }\r\n  } catch (error) {\r\n    console.error('Ошибка регистрации:', error)\r\n    this.error = error.message\r\n  }\r\n},\r\n\r\ngoToLogin() {\r\n      // Вариант 1: Переход по имени маршрута\r\n      this.$router.push({ name: 'LoginPage' });\r\n      \r\n      // Или вариант 2: Переход по пути\r\n      // this.$router.push('/');\r\n    }\r\n\r\n  }\r\n}\r\n</script>\r\n\r\n<!-- Добавим в стили -->\r\n<style scoped>\r\n.toggle-link {\r\n  background: none;\r\n  border: none;\r\n  color: #42b983;\r\n  cursor: pointer;\r\n  font-size: 1em;\r\n  margin-top: 15px;\r\n  text-decoration: underline;\r\n}\r\n.toggle-link:hover {\r\n  color: #369f6b;\r\n}\r\n</style>"],"mappings":";AA4DA,OAAOA,GAAE,MAAO,OAAM;AAEtB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACzB,IAAI;QACF;QACA,IAAI,CAAC,IAAI,CAACL,KAAK,CAACM,QAAQ,CAAC,GAAG,CAAC,EAAE;UAC7B,MAAM,IAAIC,KAAK,CAAC,0BAA0B;QAC5C;QACA,IAAI,IAAI,CAACN,QAAQ,CAACO,MAAK,GAAI,CAAC,EAAE;UAC5B,MAAM,IAAID,KAAK,CAAC,wCAAwC;QAC1D;;QAEA;QACA,MAAME,QAAO,GAAI,MAAMZ,GAAG,CAACa,IAAI,CAAC,eAAe,EAAE;UAC/CX,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC;;QAED;QACA,IAAIQ,QAAQ,CAACX,IAAI,EAAEa,OAAO,EAAE;UAC1B,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,gBAAgB;QACpC,OAAO;UACL,MAAM,IAAIN,KAAK,CAACE,QAAQ,CAACX,IAAI,EAAEgB,OAAM,IAAK,oBAAoB;QAChE;MACF,EAAE,OAAOZ,KAAK,EAAE;QACda,OAAO,CAACb,KAAK,CAAC,qBAAqB,EAAEA,KAAK;QAC1C,IAAI,CAACA,KAAI,GAAIA,KAAK,CAACc,OAAM;MAC3B;IACF,CAAC;IAEDC,SAASA,CAAA,EAAG;MACN;MACA,IAAI,CAACL,OAAO,CAACC,IAAI,CAAC;QAAEK,IAAI,EAAE;MAAY,CAAC,CAAC;;MAExC;MACA;IACF;EAEF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}